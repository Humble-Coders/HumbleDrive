# Humble Drive — copy to .env and fill in. Never commit .env.

# Supabase → Project Settings → API keys
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase → Connect (top bar) → Session pooler → URI
# Session pooler, not direct: direct connections are IPv6-only.
SUPABASE_DB_URL=

# Supabase → Project Settings → API keys → secret key.
# Used from ticket 2 onward, and stored in Supabase secrets, not here.
SUPABASE_SECRET_KEY=
