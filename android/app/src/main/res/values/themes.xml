<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only, per PRD D-21. Compose owns the real theme; this exists so
         the window background matches before the first frame and there is no
         white flash on launch. -->
    <style name="Theme.HumbleDrive" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#07090f</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
