# Web app config. Copy to .env and fill in.
# Both values are public by design — the publishable key can read nothing
# while RLS has zero policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Added by ticket 6. Maps JavaScript API only, HTTP-referrer restricted.
VITE_GOOGLE_MAPS_BROWSER_KEY=
